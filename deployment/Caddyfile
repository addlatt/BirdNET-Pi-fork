# BirdNET-Pi Caddy Configuration
# BirdNET-Pi Caddy Configuration - Routes to Go API, Preact SPA, and services
#
# INSTALLATION: This file uses {$VAR} environment variable syntax.
# Before installing, either:
# 1. Export the variables: export BIRDNET_USER=pi BIRDNET_HOME=/home/pi
# 2. Or use the install script which performs substitution automatically
#
# Required variables:
#   BIRDNET_USER - Username running BirdNET-Pi (e.g., "pi")
#   BIRDNET_HOME - Home directory (e.g., "/home/pi")

http:// {
	# Enable gzip compression for all responses
	encode gzip
	# ==========================================================================
	# Go API endpoints - proxy to Go server on port 8080
	# ==========================================================================
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# ==========================================================================
	# WebSocket endpoint for real-time updates
	# ==========================================================================
	handle /ws {
		reverse_proxy localhost:8080
	}

	# Bird recordings (browse)
	handle /By_Date/* {
		root * {$BIRDNET_HOME}/BirdSongs/Extracted
		file_server browse
	}
	handle /Charts/* {
		root * {$BIRDNET_HOME}/BirdSongs/Extracted
		file_server browse
	}

	# Live spectrogram image
	handle /spectrogram.png {
		root * {$BIRDNET_HOME}/BirdSongs/Extracted
		file_server
	}

	# Reverse proxies (external services)
	handle /stream {
		reverse_proxy localhost:8000
	}
	handle /terminal* {
		reverse_proxy localhost:8888
	}

	# ==========================================================================
	# Preact app - default handler, served at /
	# ==========================================================================
	handle {
		root * {$BIRDNET_HOME}/BirdNET-Pi/web/dist

		# Cache static assets with hashed filenames for 1 year
		@static path *.js *.css *.woff *.woff2 *.ttf
		header @static Cache-Control "public, max-age=31536000, immutable"

		# Don't cache index.html (so updates are picked up immediately)
		@html path *.html /
		header @html Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
