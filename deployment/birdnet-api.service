[Unit]
Description=BirdNET-Pi Go API Server
Documentation=https://github.com/Nachtzuster/BirdNET-Pi
After=network.target

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%HOME%/BirdNET-Pi

# Environment - paths are substituted during installation
Environment="PORT=8080"
Environment="DB_PATH=%HOME%/BirdNET-Pi/data/db/birds.db"
Environment="ML_SERVICE_URL=http://127.0.0.1:8001"
Environment="STATIC_DIR=%HOME%/BirdNET-Pi/web/dist"
Environment="CONFIG_PATH=%HOME%/BirdNET-Pi/birdnet.conf"

ExecStart=%HOME%/BirdNET-Pi/bin/birdnet-server

# Restart policy with rate limiting (prevents restart storms)
Restart=always
RestartSec=5
# Allow max 5 restarts in 60 seconds, then stop trying
StartLimitIntervalSec=60
StartLimitBurst=5

# Watchdog: systemd will restart if server doesn't respond
# (requires Go server to implement sd_notify - optional enhancement)
# WatchdogSec=30

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=%HOME%/BirdNET-Pi

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=birdnet-api

[Install]
WantedBy=multi-user.target
