[Unit]
Description=BirdNET-Pi Audio Recording Service
Documentation=https://github.com/Nachtzuster/BirdNET-Pi
After=network.target pulseaudio.service

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%HOME%/BirdNET-Pi

# Environment - paths are substituted during installation
Environment="BIRDNET_CONFIG=%HOME%/BirdNET-Pi/birdnet.conf"

ExecStart=%HOME%/BirdNET-Pi/bin/birdnet-recording --mode standard

# Restart policy with rate limiting (prevents restart storms)
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=%HOME%/BirdNET-Pi
ReadWritePaths=%HOME%/BirdSongs
ReadWritePaths=%HOME%/.config/pulse

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=birdnet-recording

[Install]
WantedBy=multi-user.target
